{
  "name": "browser-cors-unlocker",
  "private": true,
  "version": "2.0.0",
  "description": "Forth Intercept: a local, tab-scoped request lab for Chrome.",
  "type": "module",
  "scripts": {
    "dev": "TARGET=chrome vite build --watch --mode development",
    "dev:firefox": "TARGET=firefox vite build --watch --mode development",
    "dev:serve": "vite dev",
    "build:chrome": "vite build --mode production",
    "build:firefox": "TARGET=firefox vite build --mode production",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "postbuild": "tsx scripts/post-build.ts",
    "package:chrome": "tsx scripts/post-build.ts chrome",
    "check": "tsc -p tsconfig.json --noEmit && eslint src tests && vitest run && pnpm run build:chrome && playwright test",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.464.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "catalog:",
    "@types/node": "^22.10.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webextension-polyfill": "^0.10.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "catalog:",
    "eslint-plugin-react": "catalog:",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.6",
    "sass": "^1.81.0",
    "shadcn": "^4.20.1",
    "tailwindcss": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-eslint": "catalog:",
    "vite-plugin-web-extension": "^4.4.4",
    "vitest": "^2.1.8",
    "vitest-webextension-mock": "^0.0.7",
    "webextension-polyfill": "^0.10.0",
    "zip-a-folder": "^3.1.8"
  }
}
