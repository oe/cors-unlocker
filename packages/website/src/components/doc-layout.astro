---
import BaseLayout from './base-layout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout frontmatter={frontmatter}>
  <div class="site-shell grid gap-12 py-12 lg:grid-cols-[220px_minmax(0,760px)] lg:justify-center lg:py-20">
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-neutral-400">Documentation</p>
      <nav class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-sm text-neutral-600 lg:flex-col" aria-label="Documentation">
        <a href="/docs/">Overview & SDK</a>
        <a href="/playground/">SDK playground</a>
        <a href="/faq/">FAQ</a>
        <a href="/privacy/">Privacy</a>
        <a href="https://github.com/oe/cors-unlocker" target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </aside>
    <article class="prose prose-neutral max-w-none prose-headings:tracking-tight prose-h1:text-5xl prose-h1:leading-[1.02] prose-a:text-blue-700 prose-pre:rounded-xl prose-pre:border prose-pre:border-neutral-800">
      <slot />
    </article>
  </div>
</BaseLayout>
