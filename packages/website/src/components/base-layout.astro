---
import Header from './header.astro';
import Footer from './footer.astro';
import { SITE_URL, CHROME_STORE, FIREFOX_STORE, GITHUB_URL } from '../site-config';
import './tailwind.css';
interface Props {
  isHomepage?: boolean;
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}
const { frontmatter = {} } = Astro.props;
const title = frontmatter.title || Astro.props.title;
const pageTitle = title ? `${title} · Wireflip` : 'Wireflip · In-browser request proxy for developers';
const description = frontmatter.description || Astro.props.description || 'Inspect requests, repair CORS, modify headers, mock APIs and test slow networks with the local Wireflip extension for Chrome and Firefox.';
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const image = new URL('/og-v2.png', SITE_URL).href;
const structuredData = Astro.url.pathname === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Wireflip',
  url: SITE_URL,
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Chrome, Firefox',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: [CHROME_STORE, FIREFOX_STORE],
  sameAs: GITHUB_URL,
} : { '@context': 'https://schema.org', '@type': 'WebPage', name: pageTitle, description, url: canonical, isPartOf: { '@type': 'WebSite', name: 'Wireflip', url: SITE_URL } };
---
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand-mark.svg" type="image/svg+xml" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wireflip" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Wireflip — inspect and modify requests inside your browser" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body class="flex min-h-full flex-col">
    <a class="skip-link focus-ring" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="flex-1" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
